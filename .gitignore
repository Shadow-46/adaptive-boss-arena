# ---------------------------------------------------------------------------
# Unity generated folders
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# ---------------------------------------------------------------------------
# Never ignore these - they are the project
# ---------------------------------------------------------------------------
!/[Aa]ssets/
!/[Pp]ackages/
!/[Pp]roject[Ss]ettings/

# ---------------------------------------------------------------------------
# IDE / build artefacts (regenerated by Unity on demand)
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# Unity3D generated meta files for crash reports
# ---------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Builds
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Batch-mode logs and test output
# ---------------------------------------------------------------------------
/unity-*.log
/test-results.xml

# The test framework writes a throwaway bootstrap scene into Assets/ for every
# play-mode run and does not always clean it up again.
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Mixamo art: free to use in the game and its builds, but not to redistribute as raw files, so it never
# enters this public repository. See Docs/ART_INTEGRATION.md for how to fetch it; without it the generators
# fall back to the CC0 Quaternius characters.
Assets/_Project/Art/Licensed/
Assets/_Project/Art/Licensed.meta

# Downloaded sound packs: the recordings and their licences are committed, the archives and web shortcuts are not.
Assets/_Project/Audio/ThirdParty/**/*.zip
Assets/_Project/Audio/ThirdParty/**/*.zip.meta
Assets/_Project/Audio/ThirdParty/**/*.url
Assets/_Project/Audio/ThirdParty/**/*.url.meta

# Freesound compilations are cut into Takes/ and the ambience into a loop; the raw downloads stay local (all CC0,
# re-downloadable from the ids in THIRD_PARTY_NOTICES.md). The three roars play whole and are kept.
Assets/_Project/Audio/ThirdParty/Freesound/*.wav
Assets/_Project/Audio/ThirdParty/Freesound/*.wav.meta
Assets/_Project/Audio/ThirdParty/Freesound/*.aiff
Assets/_Project/Audio/ThirdParty/Freesound/*.aiff.meta
!Assets/_Project/Audio/ThirdParty/Freesound/489901__*
!Assets/_Project/Audio/ThirdParty/Freesound/132874__*
!Assets/_Project/Audio/ThirdParty/Freesound/497056__*
